SUPABASE_DB_HOST=aws-1-ap-northeast-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your_project_ref
SUPABASE_DB_PASSWORD=replace_with_the_new_database_password
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_ANON_KEY=replace_with_your_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_secret
SUPABASE_TRANSCRIPT_BUCKET=transcripts
SUPABASE_LESSON_BUCKET=lesson-media

# Email transport: on Render Free use Resend's HTTPS API (SMTP ports are blocked).
# Create a Resend API key and set it as RESEND_API_KEY in Render.
# For production delivery to users, configure a verified sending domain/address.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Flexible Learning Hub
APP_BASE_URL=https://flexible-learning-hub.onrender.com

# Optional Gmail API over HTTPS (takes precedence when GMAIL_REFRESH_TOKEN is set).
# Create an OAuth Web client and register this exact callback URL in Google Cloud:
# https://flexible-learning-hub.onrender.com/gmail_oauth_callback.php
GMAIL_CLIENT_ID=your_google_oauth_client_id
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REDIRECT_URI=https://flexible-learning-hub.onrender.com/gmail_oauth_callback.php
GMAIL_SENDER_EMAIL=your-sender@gmail.com
# Generate once by visiting /gmail_oauth_start.php after deploying the client ID/secret.
GMAIL_REFRESH_TOKEN=your_google_oauth_refresh_token

# Optional local/paid-host SMTP fallback when Gmail API and Resend are not configured.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_ENCRYPTION=SMTPS
SMTP_USERNAME=your-smtp-account@example.com
SMTP_PASSWORD=replace_with_smtp_app_password
SMTP_FROM_EMAIL=your-smtp-account@example.com
SMTP_FROM_NAME=Flexible Learning Hub
# Set to 2 temporarily while diagnosing SMTP; debug protocol output goes to server logs.
SMTP_DEBUG=0

# Save the completed file outside the web root. Windows XAMPP default:
# C:\xampp\config\flexreal.env (or set FLEXREAL_ENV_FILE to an absolute path).
# Apache must be able to read the file. File changes are read on the next request;
# restart Apache only after changing Apache-level SetEnv/FLEXREAL_ENV_FILE settings.
# Keep SUPABASE_SERVICE_ROLE_KEY server-side; never put it in HTML or JavaScript.
# In Supabase, use the server-only secret/service_role key. The matching
# SUPABASE_LESSON_BUCKET must already exist; this project currently uses lesson-media.
